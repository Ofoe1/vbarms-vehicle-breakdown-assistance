rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "");
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == "admin";
    }

    function isDriver() {
      return isSignedIn() && getUserRole() == "driver";
    }

    function isProvider() {
      return isSignedIn() && getUserRole() == "provider";
    }

    // ===== USERS =====
    match /users/{uid} {
      // Owner can always read/write their own profile
      allow read, write: if isOwner(uid);

      // Anyone signed in can read user profiles (for matching)
      allow read: if isSignedIn();
    }

    // ===== BREAKDOWN REQUESTS =====
    match /breakdownRequests/{requestId} {
      // Driver can CRUD their own requests
      allow read, create: if isSignedIn() && 
                             request.resource.data.driverId == request.auth.uid;
      
      allow read, update: if isSignedIn() && 
                             resource.data.driverId == request.auth.uid;

      // Provider can read and update their assigned requests
      allow read: if isSignedIn() && 
                     resource.data.assignedProviderId == request.auth.uid;
      
      allow update: if isSignedIn() && 
                       resource.data.assignedProviderId == request.auth.uid;

      // Admins can read all requests
      allow read: if isAdmin();
    }

    // ===== ASSIGNMENTS LOG =====
    match /assignments/{assignmentId} {
      // Provider can read their own assignments
      allow read: if isSignedIn() && 
                     resource.data.providerId == request.auth.uid;

      // Anyone can write (system operations)
      allow write: if isSignedIn();

      // Admins can read all assignments
      allow read: if isAdmin();
    }
  }
}
