rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "");
    }

    function isDriver() {
      return isSignedIn() && getUserRole() == "driver";
    }

    function isProvider() {
      return isSignedIn() && getUserRole() == "provider";
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /drivers/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /providers/{uid} {
      allow write: if isSignedIn() && request.auth.uid == uid;

      allow read: if isSignedIn();

      allow update: if isSignedIn() &&
        (request.auth.uid == uid ||
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(["availabilityStatus"]));
    }

    match /breakdownRequests/{requestId} {
      allow read, create: if isSignedIn() &&
        request.resource.data.driverId == request.auth.uid;

      allow update: if isSignedIn() &&
        resource.data.driverId == request.auth.uid;

      allow read, update: if isSignedIn() &&
        resource.data.assignedProviderId == request.auth.uid;
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn() &&
        resource.data.providerId == request.auth.uid;

      allow write: if isSignedIn();
    }
  }
}